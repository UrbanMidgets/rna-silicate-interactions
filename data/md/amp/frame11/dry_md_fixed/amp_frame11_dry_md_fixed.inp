! MD PBE0 D3BJ def2-TZVP RIJCOSX def2/J

%pal
  nprocs 8
end

%md
  Timestep 0.5_fs
  Initvel 353 #80degC
  Thermostat CSVR

  # Freeze atoms
  constraint add cartesian 90
  constraint add cartesian 91
  constraint add cartesian 92
  constraint add cartesian 93
  constraint add cartesian 94
  constraint add cartesian 95
  constraint add cartesian 96
  constraint add cartesian 97
  constraint add cartesian 98
  constraint add cartesian 99
  constraint add cartesian 100
  constraint add cartesian 101
  
  dump position stride 1 filename "trajectory.xyz"
  Run 2000
end

%maxcore 3500


*xyzfile -1 1 amp_frame11.xyz
